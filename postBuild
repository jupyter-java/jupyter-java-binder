# Install JBang
curl -Ls https://sh.jbang.dev | bash -s - app setup

# Setup up path explicitly for accessing jbang directly
export PATH=$HOME/.jbang/bin:$PATH

# Trust jupyter-java so no prompting needed for kernels
jbang trust add https://github.com/jupyter-java/

# Install the known working java kernels
jbang install-kernel@jupyter-java --java 25 jbang
jbang install-kernel@jupyter-java --java 25 jjava
jbang install-kernel@jupyter-java --java 25 rapaio
jbang install-kernel@jupyter-java --java 25 kotlin
jbang install-kernel@jupyter-java --java 25 ijava

